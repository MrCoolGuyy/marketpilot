# ┌───────────────────────────────────────────────────────────┐
# │           MarketPilot — Environment Variables            │
# └───────────────────────────────────────────────────────────┘
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Bybit API ──────────────────────────────────────────────
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true

# ── Database ───────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///data/marketpilot.db

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Demo Execution (OPTIONAL) ──────────────────────────────
# Bybit official Demo Trading API configuration.
# DEMO_PROFILE=DEMO
# DEMO_API_KEY=your_demo_api_key_here
# DEMO_API_SECRET=your_demo_api_secret_here
# DEMO_EXECUTION_ENABLED=false
